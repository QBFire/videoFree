# npm配置文件
# 设置npm镜像源和其他配置

# 使用淘宝npm镜像源（可选）
# registry=https://registry.npmmirror.com/

# 允许安装依赖时的脚本执行
# unsafe-perm=true

# 保存精确的版本号
save-exact=true

# 缓存目录配置
# cache=C:\Users\user\AppData\Roaming\npm-cache

# 忽略某些警告
# ignore-scripts=false

# 代理设置（如果需要）
# proxy=http://proxy.example.com:8080
# https-proxy=http://proxy.example.com:8080

# 启用或禁用严格SSL检查
# strict-ssl=true